# Public site URL as users open it in the browser (must match exactly: http/https + host + :port if any).
# Without ORIGIN, adapter-node assumes https://HOST — that breaks profile photo uploads on plain HTTP.
ORIGIN=http://YOUR_VPS_IP
PORT=3000
HOST=0.0.0.0
BODY_SIZE_LIMIT=8M

# Optional: also bake trusted origins into the build (comma-separated). Useful if ORIGIN env is flaky under PM2.
# CSRF_TRUSTED_ORIGINS=http://YOUR_VPS_IP,http://YOUR_VPS_IP:3000

# Behind nginx, prefer forwarding headers instead of / in addition to ORIGIN:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# TURN for WebRTC calls. Not optional in practice: two phones on mobile data are
# both behind carrier-grade NAT and a direct connection almost never forms, so
# without a relay the call reaches "connecting" and dies. Full setup: docs/turn.md
#
# Comma-separated, UDP first and TLS last — the browser keeps whichever gets through.
# TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
#
# Preferred auth: coturn `use-auth-secret` with `static-auth-secret` set to this
# same value. The server then signs a short-lived credential per user instead of
# shipping one password to every client.
# TURN_SECRET=
#
# Fallback for a throwaway local coturn only — this password is visible in the
# devtools of every user who makes a call, and stays valid until you rotate it.
# TURN_USERNAME=
# TURN_CREDENTIAL=
