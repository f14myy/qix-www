# Runtime env for production (pm2 loads this via ecosystem.config.cjs)
# ORIGIN must match the URL in the browser exactly (no trailing slash).

ORIGIN=http://217.60.240.76
PORT=3000
HOST=127.0.0.1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional TURN for WebRTC calls behind strict NAT (coturn etc.)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
